# ──────────────────────────────────────────────────────
# LLM Backend: "anthropic" | "gemini" | "local" | "ollama"
# ──────────────────────────────────────────────────────
LLM_BACKEND=local

# ── Local LLM (gbrain, LM Studio, llama-server, vLLM, …)
# Speaks the OpenAI /v1/chat/completions protocol.
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_MODEL=your-local-model-name
# LOCAL_LLM_API_KEY=                 # optional bearer token

# ── Ollama (only if not using OpenAI-compat path)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# ── Gemini (Google AI)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── Anthropic Claude
# ANTHROPIC_API_KEY=your-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────
# DB_PATH=./governance.db

# ──────────────────────────────────────────────────────
# SEC EDGAR (set your contact email per SEC policy)
# ──────────────────────────────────────────────────────
# EDGAR_USER_AGENT=GovernanceAgent/1.0 your-email@example.com
# EDGAR_HTML_MAX_CHARS=120000

# ──────────────────────────────────────────────────────
# Notifier channels (comma-separated): "telegram,email" or "telegram"
# Empty defaults to telegram if TELEGRAM_BOT_TOKEN is set, else email.
# ──────────────────────────────────────────────────────
NOTIFIER_CHANNELS=telegram

# ──────────────────────────────────────────────────────
# Telegram bot (recommended: works behind NAT via long-polling)
#   1. Create a bot with @BotFather → copy the token below
#   2. Send any message to your bot, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy the chat.id from the response
# ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:abcdef…
# TELEGRAM_CHAT_ID=123456789

# ──────────────────────────────────────────────────────
# Email (SMTP) — optional fallback channel
# ──────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=your-email@gmail.com

# ──────────────────────────────────────────────────────
# Scheduler
# ──────────────────────────────────────────────────────
# SCHEDULE_DAY=monday
# SCHEDULE_TIME=08:00
# MEETING_CHECK_TIME=07:00
# ALERT_TIERS=14,7,3,1
