# ──────────────────────────────────────────────────────
# LLM Backend: "anthropic" (cloud) or "ollama" (local)
# ──────────────────────────────────────────────────────
LLM_BACKEND=anthropic

# Anthropic (only needed if LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Ollama (only needed if LLM_BACKEND=ollama)
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

# ──────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────
# DB_PATH=./governance.db

# ──────────────────────────────────────────────────────
# SEC EDGAR (set your contact email per SEC policy)
# ──────────────────────────────────────────────────────
# EDGAR_USER_AGENT=GovernanceAgent/1.0 your-email@example.com

# ──────────────────────────────────────────────────────
# Email notifications (for the Monday digest)
# ──────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=your-email@gmail.com

# ──────────────────────────────────────────────────────
# Scheduler
# ──────────────────────────────────────────────────────
# SCHEDULE_DAY=monday
# SCHEDULE_TIME=08:00
