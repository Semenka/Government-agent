# ──────────────────────────────────────────────────────
# LLM Backend: "anthropic" or "gemini"
# ──────────────────────────────────────────────────────
LLM_BACKEND=gemini

# Gemini (only needed if LLM_BACKEND=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Anthropic (only needed if LLM_BACKEND=anthropic)
# ANTHROPIC_API_KEY=your-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────
# DB_PATH=./governance.db

# ──────────────────────────────────────────────────────
# SEC EDGAR (set your contact email per SEC policy)
# ──────────────────────────────────────────────────────
# EDGAR_USER_AGENT=GovernanceAgent/1.0 your-email@example.com

# ──────────────────────────────────────────────────────
# Email notifications (for the Monday digest)
# ──────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_TO=your-email@gmail.com

# ──────────────────────────────────────────────────────
# Scheduler
# ──────────────────────────────────────────────────────
# SCHEDULE_DAY=monday
# SCHEDULE_TIME=08:00
